import os
import shutil
from datetime import datetime, timedelta
from pathlib import Path

def get_disk_space():
    """Возвращает информацию о свободном месте на диске."""
    try:
        total, used, free = shutil.disk_usage("/")
        total_gb = total // (2**30)
        used_gb = used // (2**30)
        free_gb = free // (2**30)
        return f"Всего: {total_gb} ГБ, Занято: {used_gb} ГБ, Свободно: {free_gb} ГБ"
    except Exception as e:
        return f"Ошибка при получении места: {e}"

def find_old_screenshots(days=14):
    """Ищет файлы в папке Изображения старше указанного количества дней."""
    image_dir = Path.home() / "Изображения"
    if not image_dir.exists():
        image_dir = Path.home() / "Pictures"
    if not image_dir.exists():
        return "Папка с изображениями не найдена."
    
    cutoff_date = datetime.now() - timedelta(days=days)
    old_files = []
    
    try:
        for file in image_dir.iterdir():
            if file.is_file():
                mtime = datetime.fromtimestamp(file.stat().st_mtime)
                if mtime < cutoff_date:
                    name_lower = file.name.lower()
                    if "screen" in name_lower or "снимок" in name_lower or "screenshot" in name_lower:
                        size_mb = file.stat().st_size / (1024 * 1024)
                        old_files.append(f"{file.name} (изменён {mtime.strftime('%d.%m.%Y')}, {size_mb:.1f} МБ)")
        
        if not old_files:
            return "Старых скриншотов не найдено."
        
        result = f"Найдено старых скриншотов ({len(old_files)}):\n"
        result += "\n".join(old_files)
        return result
    except Exception as e:
        return f"Ошибка при поиске файлов: {e}"

def get_largest_files(limit=5):
    """Находит самые большие файлы в домашней папке."""
    home_dir = Path.home()
    file_sizes = []
    
    try:
        for root, dirs, files in os.walk(home_dir):
            dirs[:] = [d for d in dirs if not d.startswith('.')]
            for f in files:
                filepath = Path(root) / f
                try:
                    if filepath.is_file():
                        size = filepath.stat().st_size
                        file_sizes.append((size, filepath))
                except (PermissionError, OSError):
                    continue
                    
        file_sizes.sort(reverse=True, key=lambda x: x[0])
        
        result = f"Топ {limit} самых больших файлов:\n"
        for size, path in file_sizes[:limit]:
            size_mb = size / (1024 * 1024)
            short_path = str(path).replace(str(Path.home()), "~")
            result += f"{short_path} — {size_mb:.1f} МБ\n"
        return result
    except Exception as e:
        return f"Ошибка при поиске больших файлов: {e}"

def delete_old_screenshots(days=14):
    """Удаляет старые скриншоты (с подтверждением в main.py)."""
    image_dir = Path.home() / "Изображения"
    if not image_dir.exists():
        image_dir = Path.home() / "Pictures"
    if not image_dir.exists():
        return "Папка с изображениями не найдена."
    
    cutoff_date = datetime.now() - timedelta(days=days)
    deleted_names = []
    
    try:
        for file in image_dir.iterdir():
            if file.is_file():
                mtime = datetime.fromtimestamp(file.stat().st_mtime)
                if mtime < cutoff_date:
                    name_lower = file.name.lower()
                    if "screen" in name_lower or "снимок" in name_lower or "screenshot" in name_lower:
                        deleted_names.append(file.name)
        
        if not deleted_names:
            return "Файлов для удаления не найдено."
        
        return f"Найдено {len(deleted_names)} файлов для удаления:\n" + "\n".join(deleted_names)
    except Exception as e:
        return f"Ошибка при поиске: {e}"

def confirm_and_delete(files_to_delete):
    """
    Удаляет файлы из списка, если они находятся в папке Изображения.
    Это защита: функция не удалит файлы из других папок.
    """
    image_dir = Path.home() / "Изображения"
    if not image_dir.exists():
        image_dir = Path.home() / "Pictures"
    
    deleted_count = 0
    errors = []
    
    for filename in files_to_delete:
        filepath = image_dir / filename
        if filepath.exists() and filepath.is_file():
            try:
                filepath.unlink()
                deleted_count += 1
            except Exception as e:
                errors.append(f"{filename}: {e}")
        else:
            errors.append(f"{filename}: файл не найден")
    
    if errors:
        return f"Удалено: {deleted_count}. Ошибки: {'; '.join(errors)}"
    return f"Успешно удалено файлов: {deleted_count}."
def list_directory(dir_path):
    """Показывает содержимое указанного каталога (только внутри домашней папки)."""
    home_dir = Path.home()
    target = Path(dir_path).expanduser().resolve()

    # Защита: разрешаем смотреть только внутри домашней папки
    if not str(target).startswith(str(home_dir)):
        return "Ошибка: доступ разрешен только к папкам внутри вашей домашней директории."

    if not target.exists():
        return f"Ошибка: каталог '{dir_path}' не найден."
    if not target.is_dir():
        return f"Ошибка: '{dir_path}' — это не каталог."

    try:
        items = []
        for item in target.iterdir():
            item_type = "📁 Папка" if item.is_dir() else "📄 Файл"
            size = ""
            if item.is_file():
                size_mb = item.stat().st_size / (1024 * 1024)
                size = f" ({size_mb:.1f} МБ)"
            items.append(f"{item_type}: {item.name}{size}")

        if not items:
            return f"Каталог '{dir_path}' пуст."

        return f"Содержимое каталога '{dir_path}':\n" + "\n".join(items)
    except Exception as e:
        return f"Ошибка при чтении каталога: {e}"

def delete_item(item_path):
    """Удаляет файл или папку (только внутри домашней папки)."""
    home_dir = Path.home()
    target = Path(item_path).expanduser().resolve()

    # Защита: разрешаем удалять только внутри домашней папки
    if not str(target).startswith(str(home_dir)):
        return "Ошибка: удаление разрешено только внутри вашей домашней директории."

    if not target.exists():
        return f"Ошибка: '{item_path}' не найден."

    try:
        if target.is_dir():
            import shutil
            shutil.rmtree(target) # Удаляет папку со всем содержимым
            return f"✅ Папка '{item_path}' успешно удалена."
        else:
            target.unlink()
            return f"✅ Файл '{item_path}' успешно удален."
    except Exception as e:
        return f"Ошибка при удалении: {e}"
def find_new_files(days=7):
    """Ищет новые файлы за последние N дней в рабочих папках."""
    from datetime import datetime, timedelta
    import os
    
    home_dir = Path.home()
    folders_to_check = [
        home_dir / "Документы",
        home_dir / "Загрузки",
        home_dir / "Рабочий стол"
    ]
    
    cutoff_date = datetime.now() - timedelta(days=days)
    new_files = []
    
    try:
        for folder in folders_to_check:
            if folder.exists() and folder.is_dir():
                for root, dirs, files in os.walk(folder):
                    # Пропускаем скрытые папки
                    dirs[:] = [d for d in dirs if not d.startswith('.')]
                    for file in files:
                        filepath = Path(root) / file
                        if filepath.is_file():
                            mtime = datetime.fromtimestamp(filepath.stat().st_mtime)
                            if mtime > cutoff_date:
                                size_mb = filepath.stat().st_size / (1024 * 1024)
                                # Короткий путь для красоты
                                short_path = str(filepath).replace(str(home_dir), "~")
                                new_files.append(f"{short_path} ({size_mb:.1f} МБ, {mtime.strftime('%d.%m.%Y')})")
        
        if not new_files:
            return f"За последние {days} дней новых файлов не найдено."
        
        # Сортируем по дате (сначала самые новые)
        result = f"Найдено {len(new_files)} новых файлов за последние {days} дней:\n"
        result += "\n".join(new_files[:20]) # Показываем первые 20, чтобы не перегружать
        if len(new_files) > 20:
            result += f"\n... и еще {len(new_files) - 20} файлов."
        return result
    except Exception as e:
        return f"Ошибка при поиске новых файлов: {e}"

def check_system_errors():
    """Проверяет системный журнал на наличие ошибок с момента последней загрузки."""
    import subprocess
    
    try:
        # Запускаем journalctl: только ошибки (-p err), только текущая загрузка (-b), без пейджера (--no-pager)
        result = subprocess.run(
            ["journalctl", "-p", "err", "-b", "--no-pager"],
            capture_output=True, text=True, timeout=10
        )
        
        # Если вывод пустой (или только служебные строки), значит ошибок нет
        output = result.stdout.strip()
        if not output or "No entries" in output:
            return "✅ Системных ошибок с момента последней загрузки не обнаружено."
        
        # Если вывод слишком длинный, обрезаем его для читаемости
        lines = output.split("\n")
        if len(lines) > 15:
            return "⚠️ Обнаружены системные ошибки (показаны первые 15):\n" + "\n".join(lines[:15]) + "\n... (список обрезан)"
        
        return "⚠️ Обнаружены системные ошибки:\n" + output
        
    except FileNotFoundError:
        return "Ошибка: команда journalctl не найдена в системе."
    except subprocess.TimeoutExpired:
        return "Ошибка: проверка логов заняла слишком много времени."
    except Exception as e:
        return f"Ошибка при проверке логов: {e}"
